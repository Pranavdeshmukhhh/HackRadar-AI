# ==============================================================================
# Nagpur Hackathon Monitor - Environment Variables Template
# Copy this file to .env for local execution: cp .env.example .env
# In GitHub Actions, add these as Repository Secrets (Settings -> Secrets & Variables -> Actions)
# ==============================================================================

# 1. GitHub Integration (Required for GitHub Issues alerts)
# In GitHub Actions, this is automatically provided by the runner as ${{ secrets.GITHUB_TOKEN }}
GITHUB_TOKEN=ghp_yourPersonalAccessTokenOrSecretHere
GITHUB_REPOSITORY=your-username/nagpur-hackathon-monitor

# 2. Discord Webhook (Optional)
# Paste your Discord channel incoming webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# 3. Telegram Bot (Optional)
# Create a bot with @BotFather to get the token, and send a message to get your Chat ID
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# 4. SMTP Email Alerts (Optional)
# Works with Gmail (App Passwords), SendGrid, AWS SES, or custom SMTP servers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
ALERT_RECEIVER_EMAIL=your_personal_email@domain.com
